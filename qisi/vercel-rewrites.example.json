{
  "redirects": [
    { "source": "/api-service", "destination": "/api-service/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api-service/", "destination": "https://YOUR_BACKEND_HOST/api-service/" },
    { "source": "/api-service/:path*/", "destination": "https://YOUR_BACKEND_HOST/api-service/:path*/" },
    { "source": "/api-service/:path*", "destination": "https://YOUR_BACKEND_HOST/api-service/:path*" }
  ]
}
